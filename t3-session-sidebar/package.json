{
  "name": "@local/dsh-t3-session-sidebar",
  "version": "0.2.2",
  "license": "MIT",
  "engines": { "dsh": "0.2.2-rc.3 || 0.2.2-rc.5" },
  "scripts": {
    "build": "node ../tools/build-client.mjs",
    "check:build": "node ../tools/build-client.mjs --check",
    "test": "node --test *.test.js"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.remote-runtime.js": "./client.remote-runtime.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.remote-runtime.js",
    "native-runtime-host.js",
    "remote-runtime.js",
    "remote-transport.js",
    "device-realm.js",
    "shortcuts-bridge.js",
    "logic.js",
    "placement-controller.js",
    "migration.js",
    "contract.js",
    "remote-ws.js",
    "remote-target-client.js",
    "remote-index.js",
    "remote-supervisor.js",
    "ssh",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "zod": "^4.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
