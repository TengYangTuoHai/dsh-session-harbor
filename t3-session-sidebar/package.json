{
  "name": "@local/dsh-t3-session-sidebar",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "logic.js", "placement-controller.js", "migration.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dependencies": { "zod": "^4.0.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-context-menu"]
    }
  }
}
